# Copy to .env (which git ignores) and fill in. `docker compose --profile app up` reads it automatically.

# HMAC signing key for login tokens: any random string of 32+ characters. Changing it signs everyone out.
#   openssl rand -base64 48
JWT_KEY=

# The first admin account, created on first start if no staff users exist yet.
ADMIN_EMAIL=admin@memberpulse.local
ADMIN_PASSWORD=
