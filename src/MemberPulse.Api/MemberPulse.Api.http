@baseUrl = http://localhost:5080

GET {{baseUrl}}/health

###
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@memberpulse.local",
  "password": "Admin_Dev123!"
}

###
@token = {{login.response.body.$.accessToken}}

GET {{baseUrl}}/api/members?page=1&pageSize=20
Authorization: Bearer {{token}}

###
# @name create
POST {{baseUrl}}/api/members
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Aisha",
  "lastName": "Rahman",
  "email": "aisha.rahman@example.com",
  "dateOfBirth": "1997-06-21"
}

###
POST {{baseUrl}}/api/members/{{create.response.body.$.id}}/accounts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "type": "Savings",
  "initialDeposit": 5000
}